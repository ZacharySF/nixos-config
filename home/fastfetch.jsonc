{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "iterm",
    "source": "~/.config/fastfetch/misa2.png",
    "width": 54,
    "height": 23,
    "position": "left",
    "padding": {
      "right": 0,
      "bottom": 0
    }
  },
  "display": {
    "separator": ": ",
    "disableLinewrap": true
  },
  "modules": [
    "title",
    "separator",
    { "type": "os", "format": "{name} {version-id} {arch}" },
    "host",
    "kernel",
    "break",
    "uptime",
    { "type": "command", "key": "Packages", "text": "~/.local/bin/fastfetch-packages" },
    "shell",
    { "type": "display", "key": "Display", "format": "{width}x{height}{?refresh-rate} @ {refresh-rate} Hz{?}" },
    { "type": "wm", "key": "WM", "format": "{pretty-name} ({protocol-name})" },
    { "type": "terminal", "format": "{pretty-name}" },
    "break",
    { "type": "cpu", "format": "Core {name~18,99}" },
    { "type": "gpu", "format": "{name~34,99}" },
    { "type": "memory", "format": "{used} / {total}" },
    { "type": "swap", "format": "{used} / {total}" },
    { "type": "disk", "format": "{size-used} / {size-total}" },
    { "type": "localip", "key": "Local IP", "format": "{ipv4}" },
    { "type": "battery", "key": "Battery", "format": "{capacity} [{status~0,12}]" },
    "separator",
    { "type": "colors", "paddingLeft": 2 }
  ]
}
