{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "NixOS",
    "position": "left",
    "padding": {
      "right": 2
    }
  },
  "display": {
    "separator": ": ",
    "disableLinewrap": true
  },
  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    { "type": "packages", "format": "{nix-system} system, {nix-user} user" },
    "shell",
    { "type": "display", "key": "Display", "format": "{width}x{height}{?refresh-rate} @ {refresh-rate} Hz{?}" },
    "wm",
    "terminal",
    { "type": "cpu", "format": "{name}" },
    { "type": "gpu", "format": "{name:-40}" },
    "memory",
    "swap",
    { "type": "disk", "format": "{size-used} / {size-total} ({size-percentage})" },
    { "type": "localip", "key": "Local IP", "format": "{ipv4}" },
    { "type": "battery", "key": "Battery", "format": "{capacity} [{status}]" },
    "separator",
    "colors"
  ]
}
