{
  "anchor_to_edges": true,
  "position": "top",
  "height": 24,
  "margin": {
    "top": 4,
    "left": 8,
    "right": 8
  },
  "start": [
    {
      "type": "sys_info",
      "format": [
        "  {cpu_percent}%",
        "  {memory_percent}%"
      ],
      "interval": 5
    },
    {
      "type": "bluetooth"
    }
  ],
  "end": [
    {
      "type": "volume",
      "format": "{icon} {percentage}%",
      "icons": {
        "volume_high": "󰕾",
        "volume_medium": "󰖀",
        "volume_low": "󰕿",
        "muted": "󰝟"
      }
    },
    {
      "type": "script",
      "cmd": "/home/xelo/.local/bin/battery-icon.sh",
      "interval": 30000
    },
    {
      "type": "clock",
      "format": "%I:%M %p"
    }
  ]
}
