+// Niri exposes focused app identity over a read-only socket request. Query at
+// paste time; never change compositor configuration or send an IPC action.
+fn niri_terminal_focused() -> Option<bool> {
+    use std::io::{BufRead, BufReader};
+    use std::os::unix::net::UnixStream;
+
+    let socket = std::env::var_os("NIRI_SOCKET")?;
+    let mut stream = UnixStream::connect(socket).ok()?;
+    let timeout = Some(Duration::from_millis(100));
+    stream.set_read_timeout(timeout).ok()?;
+    stream.set_write_timeout(timeout).ok()?;
+    stream.write_all(b"\"FocusedWindow\"\n").ok()?;
+    let mut reply = String::new();
+    BufReader::new(stream).read_line(&mut reply).ok()?;
+    terminal_from_niri_reply(&reply)
+}
+
+fn terminal_from_niri_reply(reply: &str) -> Option<bool> {
+    let reply: serde_json::Value = serde_json::from_str(reply).ok()?;
+    let app_id = reply.get("Ok")?.get("FocusedWindow")?.get("app_id")?.as_str()?;
+    Some(matches!(
+        app_id,
+        "kitty" | "Kitty-workspace" | "foot" | "footclient"
+            | "org.wezfurlong.wezterm" | "Alacritty" | "com.mitchellh.ghostty"
+    ))
+}
+
+#[cfg(test)]
+mod niri_paste_tests {
+    use super::terminal_from_niri_reply;
+
+    #[test]
+    fn terminal_apps_use_terminal_paste() {
+        for app in ["kitty", "Kitty-workspace", "foot", "footclient",
+                    "org.wezfurlong.wezterm", "Alacritty", "com.mitchellh.ghostty"] {
+            let reply = serde_json::json!({"Ok":{"FocusedWindow":{"app_id":app}}});
+            assert_eq!(terminal_from_niri_reply(&reply.to_string()), Some(true));
+        }
+    }
+
+    #[test]
+    fn other_apps_keep_normal_paste() {
+        for app in ["firefox", "chromium-browser", "org.gnome.TextEditor", "com.example.footnotes"] {
+            let reply = serde_json::json!({"Ok":{"FocusedWindow":{"app_id":app}}});
+            assert_eq!(terminal_from_niri_reply(&reply.to_string()), Some(false));
+        }
+    }
+
+    #[test]
+    fn missing_focus_or_bad_reply_uses_default() {
+        for reply in [r#"{"Ok":{"FocusedWindow":null}}"#, r#"{"Err":"unavailable"}"#, "not json"] {
+            assert_eq!(terminal_from_niri_reply(reply), None);
+        }
+    }
+}
